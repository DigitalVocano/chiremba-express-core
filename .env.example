APP_NAME="Chiremba Express Core (Femtech)"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Database Configuration (MySQL or SQLite supported)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=chiremba_express_core
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Sovereign Local & Open AI Triage Models (Famo / Ollama / OpenRouter)
FAMO_API_ENDPOINT=https://famo.co.zw/api/v1/chat
FAMO_API_TOKEN=
FAMO_MODEL=llama3
OLLAMA_HOST=
OLLAMA_MODEL=llama3
OPENROUTER_API_KEY=
OPENROUTER_PAID_MODELS="meta-llama/llama-3.3-70b-instruct,deepseek/deepseek-chat"
OPENROUTER_FREE_MODELS="meta-llama/llama-3.1-8b-instruct:free,mistralai/mistral-7b-instruct:free"

# Omnichannel Low-Bandwidth SMS / WhatsApp Gateway (Zimflow)
ZIMFLOW_API_ENDPOINT=https://zimflow.co.zw/public-api/wpbox/
ZIMFLOW_API_TOKEN=
ZIMFLOW_AUTH_TEMPLATE=pointlink_otp
ZIMFLOW_TEMPLATE_LANGUAGE=en

# Mobile Money & Payment Gateways (EcoCash / Paynow)
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
ECOCASH_MERCHANT_CODE=
ECOCASH_API_KEY=

# Real-Time Telemedicine Video/Audio (LiveKit)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=

